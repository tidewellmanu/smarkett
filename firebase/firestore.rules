rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(id) { return signedIn() && uid() == id; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == "admin";
    }
    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == "user"
        && request.resource.data.accountStatus == "active";
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountStatus == resource.data.accountStatus;
      allow delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /locations/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == "active"
        || isOwner(resource.data.sellerId) || isAdmin();

      allow create: if signedIn()
        && request.resource.data.sellerId == uid()
        && request.resource.data.status in ["pending", "draft"]
        && request.resource.data.price >= 0
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100;

      // Sellers can edit their own listing but cannot transfer ownership or
      // self-approve it. Moderators/admins can change moderation fields.
      allow update: if isAdmin()
        || (isOwner(resource.data.sellerId)
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status in ["pending", "draft", "sold", "active"]
          && (request.resource.data.status != "active" || resource.data.status == "active"));

      allow delete: if isOwner(resource.data.sellerId) || isAdmin();
    }

    match /favorites/{id} {
      allow read, delete: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.listingId is string;
      allow update: if false;
    }

    match /savedSearches/{id} {
      allow read, delete: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update: if signedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == uid();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && uid() in resource.data.participantIds;
      allow create: if signedIn()
        && uid() in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if signedIn() && uid() in resource.data.participantIds;
      allow delete: if signedIn() && uid() in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn()
          && uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn()
          && uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.senderId == uid()
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create, update, delete: if isAdmin();
    }

    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.reporterId == uid()
        && request.resource.data.reason is string;
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == uid());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.reviewerId == uid();
      allow update: if signedIn() && resource.data.reviewerId == uid();
      allow delete: if isAdmin();
    }

    // Only the Cloud Function writes reveal logs. Phone numbers are never
    // returned by normal listing reads.
    match /phoneReveals/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.viewerId == uid());
      allow create, update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /moderationActions/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
